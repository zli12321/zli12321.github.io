# Every source in the default config works without credentials.
# These only raise rate limits or unlock optional sources.

# Unauthenticated GitHub search allows ~10 requests/minute. A classic token with
# no scopes (public data only) raises that to 30/minute.
GITHUB_TOKEN=

# Optional. Semantic Scholar works without a key but throttles aggressively.
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex has no key. It asks for a contact address in the polite pool.
OPENALEX_MAILTO=
